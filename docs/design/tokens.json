    "ink-500":   { "oklch": [0.50,  0.02,  155], "note": "texto secundario en claro" },
    "chalk-000": { "oklch": [1.00,  0.000, 110], "note": "superficie elevada en claro" },
    "chalk-050": { "oklch": [0.97,  0.008, 110], "note": "tiza tibia. Superficie en claro; tinta sobre acentos oscuros." },
    "chalk-100": { "oklch": [0.94,  0.010, 110], "note": "superficie hundida en claro" },
    "chalk-150": { "oklch": [0.91,  0.010, 110], "note": "texto en oscuro. Bajada a propósito: tiza pura sobre pizarra produce halación." },
    "chalk-200": { "oklch": [0.89,  0.012, 110], "note": "skeletons en claro" },
    "chalk-300": { "oklch": [0.80,  0.013, 110], "note": "borde en oscuro. Más apagado que el texto: si brilla igual, compite con la letra." },
    "chalk-400": { "oklch": [0.72,  0.014, 110], "note": "texto secundario en oscuro" },

    "turf-500":  { "oklch": [0.52, 0.13,  152], "note": "verde pista. Estado finished, éxito." },
    "turf-700":  { "oklch": [0.38, 0.10,  152] },
    "turf-200":  { "oklch": [0.90, 0.05,  152], "note": "fondo de badge finished en claro" },

    "rail-500":  { "oklch": [0.64, 0.150, 55],  "note": "arena de la pista. Acento primario, estado upcoming. C tope en sRGB a esta L = 0.159." },
    "rail-300":  { "oklch": [0.78, 0.140, 55],  "note": "acento en oscuro. C tope = 0.149." },
    "rail-200":  { "oklch": [0.92, 0.045, 55],  "note": "fondo de badge upcoming en claro. C tope = 0.048." },

