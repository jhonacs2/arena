{
  "$comment": "Fuente canónica de la paleta. La lee scripts/check-contrast.mjs y, en Fase 2, scripts/gen-tokens-css.mjs para escribir el bloque :root de styles.css. No editar los valores en el CSS a mano: se editan acá.",

  "primitives": {
    "ink-950":   { "oklch": [0.13,  0.018, 155], "note": "lo más hundido en oscuro" },
    "ink-900":   { "oklch": [0.17,  0.02,  155], "note": "verde-negro pizarra. Texto, borde y sombra en claro; tinta sobre acentos en oscuro." },
    "ink-850":   { "oklch": [0.215, 0.020, 155], "note": "superficie en oscuro. No es negro puro: el texto casi blanco sobre negro puro vibra." },
