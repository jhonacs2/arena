  "$surfacesComment": "Las tres superficies tienen que distinguirse a simple vista. Con la misma luminancia, una pantalla oscura se ve plana y sucia: era el problema del primer modo oscuro. El umbral es ΔL en oklch.",
  "surfaceSeparation": {
    "minDeltaL": 0.025,
    "pairs": [
      ["surface", "surface-raised"],
      ["surface", "surface-sunken"]
    ]
  },

  "$contrastComment": "Pares que scripts/check-contrast.mjs verifica. 'aa' exige 4.5:1 (texto normal); 'aaLarge' exige 3:1 (texto ≥24px o ≥19px bold, y bordes de 3px que actúan como delimitador no textual).",
  "contrastPairs": [
    { "theme": "light", "fg": "text",       "bg": "surface",        "level": "aa",      "what": "texto de cuerpo" },
    { "theme": "light", "fg": "text-muted", "bg": "surface",        "level": "aa",      "what": "texto secundario" },
    { "theme": "light", "fg": "text",       "bg": "surface-sunken", "level": "aa",      "what": "texto sobre fondo hundido" },
    { "theme": "light", "fg": "border",     "bg": "surface",        "level": "aaLarge", "what": "borde de 3px" },
    { "theme": "light", "fg": "accent-ink", "bg": "accent",         "level": "aa",      "what": "botón primario" },
    { "theme": "light", "fg": "live-ink",   "bg": "live",           "level": "aa",      "what": "badge EN VIVO" },
    { "theme": "light", "fg": "success-ink","bg": "success",        "level": "aa",      "what": "badge de ganada" },
    { "theme": "light", "fg": "danger-ink", "bg": "danger",         "level": "aa",      "what": "mensaje de error" },

    { "theme": "dark",  "fg": "text",       "bg": "surface",        "level": "aa",      "what": "texto de cuerpo" },
    { "theme": "dark",  "fg": "text-muted", "bg": "surface",        "level": "aa",      "what": "texto secundario" },
    { "theme": "dark",  "fg": "text",       "bg": "surface-raised", "level": "aa",      "what": "texto sobre card" },
    { "theme": "dark",  "fg": "border",     "bg": "surface",        "level": "aaLarge", "what": "borde de 3px" },
    { "theme": "dark",  "fg": "accent-ink", "bg": "accent",         "level": "aa",      "what": "botón primario" },
    { "theme": "dark",  "fg": "live-ink",   "bg": "live",           "level": "aa",      "what": "badge EN VIVO" },
    { "theme": "dark",  "fg": "success-ink","bg": "success",        "level": "aa",      "what": "badge de ganada" },
    { "theme": "dark",  "fg": "danger-ink", "bg": "danger",         "level": "aa",      "what": "mensaje de error" }
  ]
