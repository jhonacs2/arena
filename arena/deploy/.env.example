# Arena — variables de entorno
#
# Copiar a `.env` (local) o a `/etc/arena/arena.env` (VPS) y completar. El `.env`
# **no se commitea**: tiene el secreto de firma de los JWT y la contraseña de la
# base.
#
#   cp .env.example .env
#
# Cada variable tiene su comentario, y `node scripts/verify-arena.mjs deploy`
# falla si alguna se agrega sin explicar qué es. La otra mitad del mismo check
# falla si el backend lee una variable que no está acá.

# ─────────────────────────────────────────────────────────────────────────────
# El backend
# ─────────────────────────────────────────────────────────────────────────────

# Puerto en el que escucha el backend, siempre en loopback. Es el mismo número
# que pone `cloudflared/config.yml` en el `service:` del ingress: si cambia uno,
# cambia el otro.
PORT=8080

# Cadena de conexión de Postgres. En producción es el **pooler de Supabase en
# modo transaction** (puerto 6543) — el README explica por qué y cómo obtenerla.
# `sslmode=require` no es opcional: la base está en internet.
#   local:      postgres://arena:arena@localhost:5432/arena?sslmode=disable
#   producción: postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://arena:arena@localhost:5432/arena?sslmode=disable

# Tamaño máximo del pool del backend. Chico a propósito: el pooler de Supabase
# multiplexa, y un pool grande de nuestro lado no compra nada y sí consume cupo.
# Para un curso de 30 alumnos, 10 sobran.
DB_MAX_CONNS=10

# Protocolo simple, sin sentencias preparadas. **Tiene que estar en `true` con el
# pooler de Supabase en modo transaction**: ahí las sentencias preparadas no
# sobreviven a la transacción y el driver falla con
# `prepared statement "lrupsc_1" already exists`.
# Con conexión directa o pooler de sesión, `false` es más rápido.
DB_SIMPLE_PROTOCOL=true

# Aplicar el esquema al arrancar. Es idempotente, así que dejarlo prendido es lo
# cómodo: el despliegue queda en un solo paso. Ponelo en `false` si preferís
# aplicar las migraciones a mano antes de levantar el servicio.
MIGRATE=true

# Secreto de firma de los JWT (HS256). **Generarlo, no inventarlo:**
#   openssl rand -base64 48
# Si cambia, todas las sesiones abiertas se invalidan. No hay problema en
# rotarlo, pero hacerlo en medio de una clase deja a todos afuera.
JWT_SECRET=

# Orígenes que el backend acepta, separados por coma. Con el proxy de `/api` en
# el mismo dominio (opción A del README) el navegador nunca hace una llamada
# cruzada y esto solo hace falta para desarrollar.
ALLOWED_ORIGINS=http://localhost:4200

# `info` o `debug`. En clase, `info`: `debug` escribe una línea por tick de
# carrera y a 10 Hz eso es un archivo de log por carrera.
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# La cuenta del instructor
# ─────────────────────────────────────────────────────────────────────────────

# Usuario instructor que se crea al arrancar si no existe ninguno con
# `role = 'admin'`. Sin esto no habría manera de generar el primer código de
# invitación: el registro abierto no existe.
ADMIN_USERNAME=instructor

# Contraseña inicial del instructor. Se hashea con PBKDF2 al arrancar; el valor
# en claro no queda en la base. **Cambiala después del primer ingreso** y borrá
# la variable del archivo.
ADMIN_PASSWORD=

# Nombre del instructor. Solo se usa para mostrarlo en la interfaz.
ADMIN_FIRST_NAME=Instructor

# Apellido del instructor. Ídem: es texto de pantalla, no afecta al login.
ADMIN_LAST_NAME=Arena

# ─────────────────────────────────────────────────────────────────────────────
# La cookie de refresh
# ─────────────────────────────────────────────────────────────────────────────

# Dominio de la cookie de refresh. Vacío = el host que la emitió, que es lo que
# querés con `/api` en el mismo dominio (opción A del README). Solo hace falta
# ponerle algo si compartís la sesión entre subdominios.
COOKIE_DOMAIN=

# `Secure`. Siempre `true` fuera de localhost: sin esto la cookie de refresh
# viaja en claro.
COOKIE_SECURE=true

# `SameSite`: `lax`, `strict` o `none`.
#   producción con /api en el mismo dominio (opción A) → lax
#   frontend en otro dominio que la API (opción B)     → none, y COOKIE_SECURE=true
# `none` es el default porque en desarrollo el frontend está en otro puerto y
# para el navegador eso ya es otro sitio. Ponerlo en `lax` en producción es lo
# que hace que la sesión sobreviva al bloqueo de cookies de terceros.
COOKIE_SAMESITE=lax

# ─────────────────────────────────────────────────────────────────────────────
# Postgres local (solo docker-compose.yml — en producción es Supabase)
# ─────────────────────────────────────────────────────────────────────────────

# Usuario de la base local. Irrelevante fuera de la máquina de desarrollo.
POSTGRES_USER=arena

# Contraseña de la base local. El contenedor solo escucha en 127.0.0.1, así que
# acá no hace falta nada elaborado.
POSTGRES_PASSWORD=arena

# Nombre de la base local.
POSTGRES_DB=arena

# ─────────────────────────────────────────────────────────────────────────────
# El VPS
# ─────────────────────────────────────────────────────────────────────────────

# Imagen que corre `arena-api.service`. Con un registro: ghcr.io/<usuario>/arena-api:<tag>.
# Si se construye en el propio VPS, el tag local alcanza.
ARENA_IMAGE=arena-api:latest
