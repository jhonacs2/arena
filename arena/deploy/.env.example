# Arena — variables de entorno
#
# Copiar a `.env` (local) o a `/etc/arena/arena.env` (VPS) y completar. El `.env`
# **no se commitea**: tiene el secreto de firma de los JWT y la contraseña de la
# base.
#
#   cp .env.example .env
#
# Cada variable tiene su comentario, y `node scripts/verify-arena.mjs deploy`
# falla si alguna se agrega sin explicar qué es. La otra mitad del mismo check
# falla si el backend lee una variable que no está acá.

# ─────────────────────────────────────────────────────────────────────────────
# El backend
# ─────────────────────────────────────────────────────────────────────────────

# Puerto en el que escucha el backend **adentro del contenedor**, siempre 8080.
# No es el que tipeás desde el VPS: ese es `API_PORT`.
PORT=8080

# Puerto del **host** al que el compose publica el backend, siempre atado a
# 127.0.0.1. Adentro del contenedor sigue siendo `PORT`; esto es solo por dónde
# lo alcanzás desde la máquina.
#   local:      8099   — el 8080 del host lo ocupa cualquier cosa
#   VPS:        18099  — ahí además está WorkAdventure; nada de puertos comunes
# Es el mismo número que pone `cloudflared/config.yml` en el `service:` del
# ingress: si cambia uno, cambia el otro. En local, además, es el `target` de
# `frontend/proxy.conf.json`. No lo lee el backend, solo el compose.
API_PORT=8099

# Cadena de conexión de Postgres. La base corre en el mismo VPS que el backend
# (arena/CLAUDE.md §2), así que la conexión no sale de la máquina.
#   local:      postgres://arena:arena@localhost:5432/arena?sslmode=disable
#   VPS:        lo arma `docker-compose.prod.yml` contra el servicio `db`, y lo
#               que pongas acá queda pisado por él. Se completa igual, para que
#               un `psql` desde el VPS tenga de dónde copiarla.
DATABASE_URL=postgres://arena:arena@localhost:5432/arena?sslmode=disable

# Tamaño máximo del pool del backend. Chico a propósito: 30 alumnos no generan
# 30 consultas simultáneas, y cada conexión ociosa igual le cuesta memoria a
# Postgres. Si lo subís, subí también `PG_MAX_CONNECTIONS`, que tiene que ser
# mayor —el pool no es el único que se conecta.
DB_MAX_CONNS=10

# Protocolo simple, sin sentencias preparadas. Con Postgres directo va en
# `false`, que es más rápido. Solo hace falta ponerlo en `true` detrás de un
# pooler en modo transaction —Supabase, pgbouncer—, donde las sentencias
# preparadas no sobreviven a la transacción y el driver falla con
# `prepared statement "lrupsc_1" already exists`.
DB_SIMPLE_PROTOCOL=false

# Aplicar el esquema al arrancar. Es idempotente, así que dejarlo prendido es lo
# cómodo: el despliegue queda en un solo paso. Ponelo en `false` si preferís
# aplicar las migraciones a mano antes de levantar el servicio.
MIGRATE=true

# Secreto de firma de los JWT (HS256). **Generarlo, no inventarlo:**
#   openssl rand -base64 48
# Si cambia, todas las sesiones abiertas se invalidan. No hay problema en
# rotarlo, pero hacerlo en medio de una clase deja a todos afuera.
JWT_SECRET=

# Orígenes que el backend acepta, separados por coma. Con el proxy de `/api` en
# el mismo dominio (opción A del README) el navegador nunca hace una llamada
# cruzada y esto solo hace falta para desarrollar.
ALLOWED_ORIGINS=http://localhost:4200

# `info` o `debug`. En clase, `info`: `debug` escribe una línea por tick de
# carrera y a 10 Hz eso es un archivo de log por carrera.
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# La cuenta del instructor
# ─────────────────────────────────────────────────────────────────────────────

# Usuario instructor que se crea al arrancar si no existe ninguno con
# `role = 'admin'`. Sin esto no habría manera de generar el primer código de
# invitación: el registro abierto no existe.
ADMIN_USERNAME=instructor

# Contraseña inicial del instructor. Se hashea con PBKDF2 al arrancar; el valor
# en claro no queda en la base. **Cambiala después del primer ingreso** y borrá
# la variable del archivo.
ADMIN_PASSWORD=

# Nombre del instructor. Solo se usa para mostrarlo en la interfaz.
ADMIN_FIRST_NAME=Instructor

# Apellido del instructor. Ídem: es texto de pantalla, no afecta al login.
ADMIN_LAST_NAME=Arena

# ─────────────────────────────────────────────────────────────────────────────
# La cookie de refresh
# ─────────────────────────────────────────────────────────────────────────────

# Dominio de la cookie de refresh. Vacío = el host que la emitió, que es lo que
# querés con `/api` en el mismo dominio (opción A del README). Solo hace falta
# ponerle algo si compartís la sesión entre subdominios.
COOKIE_DOMAIN=

# `Secure`. Siempre `true` fuera de localhost: sin esto la cookie de refresh
# viaja en claro.
COOKIE_SECURE=true

# `SameSite`: `lax`, `strict` o `none`.
#   producción con /api en el mismo dominio (opción A) → lax
#   frontend en otro dominio que la API (opción B)     → none, y COOKIE_SECURE=true
# `none` es el default porque en desarrollo el frontend está en otro puerto y
# para el navegador eso ya es otro sitio. Ponerlo en `lax` en producción es lo
# que hace que la sesión sobreviva al bloqueo de cookies de terceros.
COOKIE_SAMESITE=lax

# ─────────────────────────────────────────────────────────────────────────────
# Postgres — el de desarrollo y el del VPS son el mismo contenedor
# ─────────────────────────────────────────────────────────────────────────────

# Usuario de la base.
POSTGRES_USER=arena

# Contraseña de la base. En desarrollo da igual: el contenedor solo escucha en
# 127.0.0.1. **En el VPS generala** —`openssl rand -base64 24`— aunque la base no
# publique ningún puerto: el día que alguien la exponga cinco minutos para
# depurar, `arena/arena` es la contraseña que ya probó todo el mundo.
POSTGRES_PASSWORD=arena

# Nombre de la base.
POSTGRES_DB=arena

# ─────────────────────────────────────────────────────────────────────────────
# El VPS — imagen y techos de memoria (solo docker-compose.prod.yml)
# ─────────────────────────────────────────────────────────────────────────────

# Imagen que corre `arena-api.service`. Con un registro: ghcr.io/<usuario>/arena-api:<tag>.
# Si se construye en el propio VPS, el tag local alcanza.
ARENA_IMAGE=arena-api:latest

# Techo de memoria del contenedor de Postgres. 256m es el mínimo cómodo para 30
# alumnos con `DB_MAX_CONNS=10`: entran los 64MB de `shared_buffers`, los procesos
# por conexión y el autovacuum. El compose pone el swap en el mismo número, así
# que este es el techo de verdad: al pasarlo, el kernel mata el contenedor.
#
# Ojo al leer `docker stats`: buena parte de lo que cuenta es caché de páginas de
# los archivos de la base, que el kernel suelta antes de matar a nadie. Ver un
# número cerca del techo no es señal de que falte memoria.
DB_MEM_LIMIT=256m

# Techo de memoria del backend. Un binario de Go con 30 WebSockets abiertos y un
# pool de 10 conexiones vive en unos 60MB; 192m deja aire para el pico del
# arranque. El compose además le pone `GOMEMLIMIT=150MiB` para que el recolector
# junte antes de llegar acá — si lo subís, subí también aquel.
API_MEM_LIMIT=192m

# `max_connections` de Postgres. Tiene que ser **mayor** que `DB_MAX_CONNS`: el
# pool del backend no es el único que se conecta —el autovacuum y tu psql
# también—. Cada conexión cuesta memoria aunque esté ociosa, así que tampoco
# conviene inflarlo «por las dudas».
PG_MAX_CONNECTIONS=25

# `shared_buffers` de Postgres. La regla de siempre es el 25% de la memoria
# disponible; con `DB_MEM_LIMIT=256m` eso es 64MB. Si subís uno, subí el otro.
PG_SHARED_BUFFERS=64MB
